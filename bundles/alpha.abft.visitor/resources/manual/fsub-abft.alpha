affine fsub_abft [N]->{: N>0}
 inputs
 	L 			 : {[i,j] : 0<=j<=i<N}
 	b 			 : {[i]   : 0<=i<N}
 outputs
 	x 			 : {[i]   : 0<=i<N}
 	Inv_x_c 	 : {[s]   : 0<=s<1}
 	
 locals
	x_c_0, x_c_1 : {[s]	 : 0<=s<1}

 let
 	x[i] = case {
 		{: 0 = i}   :  b[i] / L[i,i];
 		{: 0 < i}   : (b[i] - reduce(+, [j], {: 0<=j<i} : L[i,j] * x[j])) / L[i,i];
 	};
 	
 	Inv_x_c[s] = (x_c_0 - x_c_1)/x_c_0;
 	
 	x_c_0[s]   = reduce (+, [i], x[i]);
 	
 	x_c_1[s]   = reduce (+, [i], 
 		case {
 			{: 0 = i}   :  b[i] / L[i,i];
 			{: 0 < i}   : (b[i] - reduce(+, [j], {: 0<=j<i} : L[i,j] * x[j])) / L[i,i];
 		}
 	);
.