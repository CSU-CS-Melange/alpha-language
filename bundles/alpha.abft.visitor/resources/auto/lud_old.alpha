
affine lud_aabft [N] -> {  : N > 0 }
	inputs
		A : {[i, j]: 0 <= i < N and 0 <= j < N }
	outputs
		L : {[i, j]: i < N and 0 <= j <= i }
		U : {[i, j]: i >= 0 and i <= j < N }
		check_U_i_inv : {[i]: 0 <= i < N }
		check_U_j_inv : {[j]: 0 <= j < N }
		check_L_i_inv : {[i]: 0 <= i < N }
		check_L_j_inv : {[j]: 0 <= j < N }
	locals
		check_U_i_0 : {[i]: 0 <= i < N }
		check_U_i_1 : {[i]: 0 <= i < N }
		check_U_j_0 : {[j]: 0 <= j < N }
		check_U_j_1 : {[j]: 0 <= j < N }
		check_L_i_0 : {[i]: 0 <= i < N }
		check_L_i_1 : {[i]: 0 <= i < N }
		check_L_j_0 : {[j]: 0 <= j < N }
		check_L_j_1 : {[j]: 0 <= j < N }
	when {  : N > 0 } let
		U[i,j] = case  {
			{: i = 0 } : A[i,j];
			{: i > 0 and j >= i } : (A[i,j] - reduce(+, (i,j,k->i,j), {: 0 <= k < i } : (L[i,k] * U[k,j])));
		};
		
		L[i,j] = case  {
			{: j = 0 } : (A[i,j] / U[j,j]);
			{: j > 0 } : ((A[i,j] - reduce(+, (i,j,k->i,j), {: 0 <= k < j } : (L[i,k] * U[k,j]))) / U[j,j]);
		};
		
		check_U_i_0[i] = reduce(+, (i,j->i), U[i,j]);
		
		check_U_i_1[i] = reduce(+, (i,j->i), (i,j->i,j)@({[i, j]: i >= 0 and i <= j < N } : case  {
			{[i, j]: i = 0 and N > 0 } : (i,j->i,j)@A;
			{[i, j]: N > 0 and i > 0 and j >= i } : ((i,j->i,j)@A - reduce(+, (i,j,k->i,j), {[i, j, k]: N > 0 and 0 <= k < i } : ((i,j,k->i,k)@L * (i,j,k->k,j)@U)));
		}));
		
		check_U_i_inv[i] = ((check_U_i_0 - check_U_i_1) / check_U_i_0);
		
		check_U_j_0[j] = reduce(+, (i,j->j), U[i,j]);
		
		check_U_j_1[j] = reduce(+, (i,j->j), (i,j->i,j)@({[i, j]: i >= 0 and i <= j < N } : case  {
			{[i, j]: i = 0 and N > 0 } : (i,j->i,j)@A;
			{[i, j]: N > 0 and i > 0 and j >= i } : ((i,j->i,j)@A - reduce(+, (i,j,k->i,j), {[i, j, k]: N > 0 and 0 <= k < i } : ((i,j,k->i,k)@L * (i,j,k->k,j)@U)));
		}));
		
		check_U_j_inv[j] = ((check_U_j_0 - check_U_j_1) / check_U_j_0);
		
		check_L_i_0[i] = reduce(+, (i,j->i), L[i,j]);
		
		check_L_i_1[i] = reduce(+, (i,j->i), (i,j->i,j)@({[i, j]: i < N and 0 <= j <= i } : case  {
			{[i, j]: j = 0 and N > 0 } : ((i,j->i,j)@A / (i,j->j,j)@U);
			{[i, j]: N > 0 and j > 0 } : (((i,j->i,j)@A - reduce(+, (i,j,k->i,j), {[i, j, k]: N > 0 and 0 <= k < j } : ((i,j,k->i,k)@L * (i,j,k->k,j)@U))) / (i,j->j,j)@U);
		}));
		
		check_L_i_inv[i] = ((check_L_i_0 - check_L_i_1) / check_L_i_0);
		
		check_L_j_0[j] = reduce(+, (i,j->j), L[i,j]);
		
		check_L_j_1[j] = reduce(+, (i,j->j), (i,j->i,j)@({[i, j]: i < N and 0 <= j <= i } : case  {
			{[i, j]: j = 0 and N > 0 } : ((i,j->i,j)@A / (i,j->j,j)@U);
			{[i, j]: N > 0 and j > 0 } : (((i,j->i,j)@A - reduce(+, (i,j,k->i,j), {[i, j, k]: N > 0 and 0 <= k < j } : ((i,j,k->i,k)@L * (i,j,k->k,j)@U))) / (i,j->j,j)@U);
		}));
		
		check_L_j_inv[j] = ((check_L_j_0 - check_L_j_1) / check_L_j_0);
.
